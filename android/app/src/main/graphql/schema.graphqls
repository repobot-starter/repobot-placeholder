# Ai domain: the voice session broker for the talk pack. Chat streaming does
# not go through GraphQL — it needs a streaming transport, served by the
# ai__request__chat function (see firebase/functions/src/CloudFunctions/Ai.ts).
#
# createAiVoiceSession is public (see publicOperationRootFields in
# GraphqlServer.ts): the talk surface works without sign-in, mirroring shop.
# The OpenAI API key never leaves the server — the client only receives a
# short-lived Realtime client secret.

type AiVoiceSession {
    "Short-lived secret the native app opens its OpenAI Realtime WebSocket with."
    clientSecret: String!
    "When the client secret expires; reconnect by minting a new session."
    expiresAt: Instant
    "The realtime model to pass when connecting, e.g. \"gpt-realtime-2\"."
    model: String!
    "The voice the session speaks with."
    voice: String!
}
type Account {
    id: Id!
    name: String!
    createdTime: Instant!
}

# Connection
type AccountConnection {
    nodes: [Account]!
    pageInfo: PageInfo!
}

input AccountConnectionInput {
    filters: AccountConnectionFilters
    connection: ConnectionInput!
}

input AccountConnectionFilters {
    name: String
}

# Create
input CreateAccountInput {
    idempotencyKey: String!
    fields: CreateAccountFields!
}

input CreateAccountFields {
    name: String!
}
type User {
    id: Id!
    email: String!
    displayName: String!
    status: UserStatus!
    account: Account
    createdTime: Instant!
    "The user's avatar upload (storage kernel), or null when none is set."
    avatarUploadId: Id
}

enum UserStatus {
    ACTIVE
    DISABLED
}

# Connection
type UserConnection {
    nodes: [User]!
    pageInfo: PageInfo!
}

input UserConnectionInput {
    filters: UserConnectionFilters
    connection: ConnectionInput!
}

input UserConnectionFilters {
    email: String
    displayName: String
    statuses: [UserStatus!]
}

# Create
input CreateUserInput {
    idempotencyKey: String!
    fields: CreateUserFields!
}

input CreateUserFields {
    accountId: Id!
    email: String!
    displayName: String!
}

# Update
input UpdateUserInput {
    objectId: Id!
    idempotencyKey: String!
    fields: UpdateUserFields!
}

input UpdateUserFields {
    displayName: String
    status: UserStatus
    "A READY PUBLIC upload id from the storage kernel (Settings avatar flow)."
    avatarUploadId: Id
}
# The jobs kernel's observability surface (see docs/jobs.md). Jobs
# themselves are config in src/Jobs/JobsRegistry.ts; the API only exposes
# the run ledger so owners and agents can see what ran, when, and how it
# went. The jobRuns query is authenticated (never in the public allowlists).

enum JobRunStatus {
    "The run claimed its due time and is executing (or crashed mid-run)."
    RUNNING
    "The handler completed."
    SUCCEEDED
    "The handler threw; error carries the message."
    FAILED
}

"One claimed (job, due time) from the job_runs ledger."
type JobRun {
    id: Id!
    "The registry name of the job (src/Jobs/JobsRegistry.ts)."
    jobName: String!
    "The cron due time this run claimed (UTC, minute precision)."
    scheduledFor: Instant!
    startedAt: Instant!
    finishedAt: Instant
    status: JobRunStatus!
    "The thrown error's message when status is FAILED."
    error: String
}
# Payments kernel: one-off and subscription checkout sessions with a
# simulated sandbox mode, a purchase ledger, and a subscription state table.
# One-off checkout operations are public (buyers are anonymous; see
# publicOperationRootFields in GraphqlServer.ts); everything touching
# subscriptions is authenticated — recurring billing entitles an account.
# Domains that sell things (shop for one-off, saas for subscriptions) own
# their product catalogs and compose these types — see docs/payments.md.

enum CheckoutSessionStatus {
    PENDING
    PAID
}

enum CheckoutProvider {
    "Sandbox-only simulated checkout (PAYMENTS_MODE=local); no real payment."
    LOCAL
    "Stripe hosted Checkout (PAYMENTS_MODE=stripe)."
    STRIPE
}

enum CheckoutMode {
    "A one-off charge (the default; buyers are anonymous)."
    PAYMENT
    "Recurring billing; the session belongs to an authenticated user."
    SUBSCRIPTION
}

enum SubscriptionInterval {
    MONTH
    YEAR
}

enum SubscriptionStatus {
    ACTIVE
    PAST_DUE
    CANCELED
}

type CheckoutSession {
    id: Id!
    provider: CheckoutProvider!
    status: CheckoutSessionStatus!
    mode: CheckoutMode!
    "Where to send the buyer to pay: the in-app test checkout or Stripe's hosted page."
    checkoutUrl: String!
    "Product snapshot taken at checkout time."
    productKey: String!
    productName: String!
    "Total in the currency's minor units."
    amountTotal: Int!
    currency: String!
    "Recurring billing period; null for one-off payments."
    recurringInterval: SubscriptionInterval
    "True when the product has a session-gated download (see docs/payments.md)."
    deliveryAvailable: Boolean!
    createdTime: Instant!
}

input CompleteTestCheckoutSessionInput {
    sessionId: Id!
}

"""
One user's subscription: written exactly once when its checkout session
reaches PAID, then moved through ACTIVE / PAST_DUE / CANCELED by Stripe's
lifecycle events. Never anonymous.
"""
type PaymentSubscription {
    id: Id!
    status: SubscriptionStatus!
    provider: CheckoutProvider!
    "Product snapshot taken at activation time."
    productKey: String!
    productName: String!
    "Per-period total in the currency's minor units."
    amountTotal: Int!
    currency: String!
    recurringInterval: SubscriptionInterval!
    "End of the current billing period as reported by Stripe; null for LOCAL subscriptions."
    currentPeriodEnd: Instant
    createdTime: Instant!
}

input CreateBillingPortalSessionInput {
    "The web app's origin (window.location.origin); the portal's return URL is built from it."
    origin: String!
}

type BillingPortalSession {
    "Where to send the user to manage billing: Stripe's Billing Portal, or the in-app test billing page in local mode."
    url: String!
}

"One PAID checkout, written exactly once no matter which observer saw payment first."
type Purchase {
    id: Id!
    checkoutSessionId: Id!
    provider: CheckoutProvider!
    productKey: String!
    productName: String!
    "Total in the currency's minor units."
    amountTotal: Int!
    currency: String!
    "Buyer email from the payment provider when available (receipts are sent here); null for LOCAL test checkouts."
    buyerEmail: String
    createdTime: Instant!
}

# Connection
type PurchaseConnection {
    nodes: [Purchase]!
    pageInfo: PageInfo!
}

input PurchaseConnectionInput {
    connection: ConnectionInput!
}
type Project {
    id: Id!
    name: String!
    description: String
    status: ProjectStatus!
    createdBy: User!
    memberships: [ProjectMembership!]!
    createdTime: Instant!
    archivedAt: Instant
}

enum ProjectStatus {
    ACTIVE
    ARCHIVED
}

type ProjectMembership {
    id: Id!
    role: ProjectMembershipRole!
    user: User!
    project: Project!
    createdTime: Instant!
}

enum ProjectMembershipRole {
    OWNER
    EDITOR
    VIEWER
}

# Connection
type ProjectConnection {
    nodes: [Project]!
    pageInfo: PageInfo!
}

input ProjectConnectionInput {
    filters: ProjectConnectionFilters
    connection: ConnectionInput!
}

input ProjectConnectionFilters {
    name: String
    statuses: [ProjectStatus!]
}

# Create
input CreateProjectInput {
    idempotencyKey: String!
    fields: CreateProjectFields!
}

input CreateProjectFields {
    name: String!
    description: String
}

# Update
input UpdateProjectInput {
    objectId: Id!
    idempotencyKey: String!
    fields: UpdateProjectFields!
}

input UpdateProjectFields {
    name: String
    description: String
    doArchive: Boolean
}

# Membership
input AddProjectMemberInput {
    idempotencyKey: String!
    fields: AddProjectMemberFields!
}

input AddProjectMemberFields {
    projectId: Id!
    userId: Id!
    role: ProjectMembershipRole!
}

input UpdateProjectMemberInput {
    objectId: Id!
    idempotencyKey: String!
    fields: UpdateProjectMemberFields!
}

input UpdateProjectMemberFields {
    role: ProjectMembershipRole!
}

input RemoveProjectMemberInput {
    objectId: Id!
}
# The push kernel's device-registration surface (see docs/push.md). Both
# mutations are authenticated app-user operations (never in the public
# allowlists): a registration always belongs to an accountable user. Sending
# never goes through GraphQL — domains call the push service directly.

enum PushDevicePlatform {
    "A browser, via Web Push (the only channel with a live transport today)."
    WEB
    "An iPhone/iPad via APNs. Registration rails exist; the transport is the C1b follow-up."
    IOS
    "An Android device via FCM. Registration rails exist; the transport is the C1b follow-up."
    ANDROID
}

"One registered push destination (a browser subscription; native devices in C1b)."
type PushDevice {
    id: Id!
    platform: PushDevicePlatform!
    "The transport identity: the Web Push subscription endpoint (native device tokens in C1b)."
    endpoint: String!
    createdTime: Instant!
    "Bumped every time the endpoint is (re-)registered."
    rotatedTime: Instant!
}

input RegisterPushDeviceInput {
    platform: PushDevicePlatform!
    "Unique per browser/device; registration upserts on it."
    endpoint: String!
    "The full browser PushSubscription JSON (endpoint + keys.p256dh + keys.auth) for WEB."
    subscriptionJson: String!
}

input UnregisterPushDeviceInput {
    endpoint: String!
}
# QuickBooks domain: the workspace's QuickBooks company connection plus read
# access to its accounting data (company snapshot, customers, invoices). All
# operations require an authenticated caller (the default gate in
# GraphqlServer.ts — none of these fields are public).
#
# In QUICKBOOKS_MODE=local (the sandbox and v1 deploys) the data is the
# deterministic simulated sample company; customer and invoice ids are
# QuickBooks-side ids, not database row ids, so they are plain Strings.

type QuickBooksConnection {
    id: Id!
    "The QuickBooks company (realm) id this connection is bound to."
    realmId: String!
    companyName: String!
    mode: QuickBooksMode!
    connectedTime: Instant!
}

enum QuickBooksMode {
    LOCAL
    INTUIT
}

type QuickBooksStatus {
    connected: Boolean!
    connection: QuickBooksConnection
}

type QuickBooksCompanySnapshot {
    companyName: String!
    "Lowercase ISO currency code, e.g. \"usd\"."
    currency: String!
    "Sum of paid invoice totals, in the currency's minor units (cents for USD)."
    revenueMinorUnits: Int!
    "Sum of unpaid invoice balances (open + overdue), in minor units."
    outstandingMinorUnits: Int!
    "Sum of overdue invoice balances, in minor units."
    overdueMinorUnits: Int!
    paidInvoiceCount: Int!
    openInvoiceCount: Int!
    overdueInvoiceCount: Int!
    customerCount: Int!
}

type QuickBooksCustomer {
    "QuickBooks-side customer id."
    id: String!
    displayName: String!
    companyName: String
    email: String!
    city: String!
    state: String!
    "Date the customer was added, as YYYY-MM-DD."
    customerSince: String!
    "Sum of this customer's unpaid invoice balances, in minor units."
    openBalanceMinorUnits: Int!
}

type QuickBooksInvoice {
    "QuickBooks-side invoice id."
    id: String!
    docNumber: String!
    customerId: String!
    customerName: String!
    status: QuickBooksInvoiceStatus!
    "Issue date as YYYY-MM-DD."
    issueDate: String!
    "Due date as YYYY-MM-DD."
    dueDate: String!
    "Invoice total in minor units."
    totalMinorUnits: Int!
    "Unpaid remainder in minor units; 0 for paid invoices."
    balanceMinorUnits: Int!
}

enum QuickBooksInvoiceStatus {
    PAID
    OPEN
    OVERDUE
}

input QuickBooksInvoicesInput {
    filters: QuickBooksInvoicesFilters
}

input QuickBooksInvoicesFilters {
    statuses: [QuickBooksInvoiceStatus!]
}

input ConnectQuickBooksInput {
    idempotencyKey: String!
}
# Saas domain: the subscription exemplar composing the payments kernel — the
# recurring-billing sibling of the Shop domain. The saas pack owns its
# server-side plan catalog; subscription and checkout session types live in
# Payments/Payments.gql. Unlike the shop's anonymous checkout, the mutation
# here is authenticated (NOT in the public allowlist): recurring billing
# entitles an account. See docs/payments.md.

input CreateSubscriptionCheckoutSessionInput {
    idempotencyKey: String!
    fields: CreateSubscriptionCheckoutSessionFields!
}

input CreateSubscriptionCheckoutSessionFields {
    "The web app's origin (window.location.origin); success/cancel redirects are built from it."
    origin: String!
    "Which catalog plan to subscribe to; omitted means the default plan."
    productKey: String
}
type Query {
    #
    # Identity
    #

    currentUser: User!

    accounts(input: AccountConnectionInput!): AccountConnection!

    users(input: UserConnectionInput!): UserConnection!
    userCreateFormSchema: SchemaForm!
    userUpdateFormSchema(input: SchemaFormUpdateInput!): SchemaForm!

    #
    # Project
    #

    project(id: Id!): Project!
    projects(input: ProjectConnectionInput!): ProjectConnection!
    projectCreateFormSchema: SchemaForm!
    projectUpdateFormSchema(input: SchemaFormUpdateInput!): SchemaForm!

    #
    # Shop (public: buyers are anonymous)
    #

    shopProduct: ShopProduct!
    shopProducts: [ShopProduct!]!

    #
    # Payments kernel (checkoutSession public; purchases and mySubscription
    # authenticated — subscriptions are never anonymous)
    #

    checkoutSession(id: Id!): CheckoutSession!
    purchases(input: PurchaseConnectionInput!): PurchaseConnection!
    "The caller's subscription (most recent; optionally scoped to a product), or null."
    mySubscription(productKey: String): PaymentSubscription

    #
    # Storage kernel (authenticated: files always have an accountable owner)
    #

    "The download URL for a READY upload (PUBLIC: stable; PRIVATE: owner-checked, short-lived)."
    fileUrl(uploadId: Id!): FileUrl!

    #
    # Jobs kernel (authenticated: run history for owners and agents)
    #

    "Scheduled-job run history, newest first (optionally one job, capped at 200)."
    jobRuns(jobName: String, limit: Int): [JobRun!]!

    #
    # QuickBooks (authenticated: the accounting dashboard and advisor tools)
    #

    quickBooksStatus: QuickBooksStatus!
    quickBooksCompanySnapshot: QuickBooksCompanySnapshot!
    quickBooksCustomers: [QuickBooksCustomer!]!
    quickBooksInvoices(input: QuickBooksInvoicesInput): [QuickBooksInvoice!]!
}

type Mutation {
    #
    # Identity
    #

    createAccount(input: CreateAccountInput!): Account!
    createUser(input: CreateUserInput!): User!
    updateUser(input: UpdateUserInput!): User!

    #
    # Project
    #

    createProject(input: CreateProjectInput!): Project!
    updateProject(input: UpdateProjectInput!): Project!
    addProjectMember(input: AddProjectMemberInput!): ProjectMembership!
    updateProjectMember(input: UpdateProjectMemberInput!): ProjectMembership!
    removeProjectMember(input: RemoveProjectMemberInput!): Boolean!

    #
    # Shop (public: buyers are anonymous)
    #

    createCheckoutSession(input: CreateCheckoutSessionInput!): CheckoutSession!

    #
    # Saas (authenticated: subscription checkout is never anonymous)
    #

    createSubscriptionCheckoutSession(input: CreateSubscriptionCheckoutSessionInput!): CheckoutSession!

    #
    # Payments kernel (completeTestCheckoutSession public: the sandbox test
    # checkout completes here; the subscription mutations are authenticated)
    #

    completeTestCheckoutSession(input: CompleteTestCheckoutSessionInput!): CheckoutSession!
    "A Billing Portal URL for the caller's subscription (the in-app test billing page in local mode)."
    createBillingPortalSession(input: CreateBillingPortalSessionInput!): BillingPortalSession!
    "Cancels the caller's simulated subscription; refuses when PAYMENTS_MODE=stripe."
    cancelTestSubscription: PaymentSubscription!

    #
    # Storage kernel (authenticated)
    #

    "Mints an upload slot: a PENDING row plus the URL and headers for the byte PUT."
    createUpload(input: CreateUploadInput!): UploadSlot!
    "Verifies the bytes arrived and flips the upload to READY (owner-only, idempotent)."
    finalizeUpload(input: FinalizeUploadInput!): Upload!
    "Deletes the stored object and its row (owner-only)."
    deleteUpload(input: DeleteUploadInput!): Boolean!

    #
    # Push kernel (authenticated: a registration always belongs to an app user)
    #

    "Registers (or rotates) a push destination for the caller, upserting on endpoint."
    registerPushDevice(input: RegisterPushDeviceInput!): PushDevice!
    "Removes the caller's registration for the endpoint; true when one was removed."
    unregisterPushDevice(input: UnregisterPushDeviceInput!): Boolean!

    #
    # QuickBooks (authenticated)
    #

    connectQuickBooks(input: ConnectQuickBooksInput!): QuickBooksConnection!
    disconnectQuickBooks: Boolean!

    #
    # Ai (public: the talk surface works without sign-in)
    #

    createAiVoiceSession: AiVoiceSession!
}
# Shop domain: the storefront exemplar composing the payments kernel. The
# shop owns its server-side product catalog; checkout session types live in
# Payments/Payments.gql. All fields here are public (see
# publicOperationRootFields in GraphqlServer.ts) — buyers never sign in.

type ShopProduct {
    key: String!
    name: String!
    tagline: String!
    "Price in the currency's minor units (cents for USD)."
    priceMinorUnits: Int!
    "Lowercase ISO currency code, e.g. \"usd\"."
    currency: String!
}

input CreateCheckoutSessionInput {
    idempotencyKey: String!
    fields: CreateCheckoutSessionFields!
}

input CreateCheckoutSessionFields {
    "The web app's origin (window.location.origin); success/cancel redirects are built from it."
    origin: String!
    "Which catalog product to charge for; omitted means the storefront's default product."
    productKey: String
}
# The storage kernel's API (see docs/storage.md). All four operations are
# authenticated — files always have an accountable principal behind them.
# URL shape: signed GCS URLs are absolute; URLs served by the storage
# function are paths starting with "/" that clients resolve against the
# storage endpoint derived from the GraphQL URL.

enum UploadVisibility {
    "Anyone with the file URL can read it (stable /file/<id> serving URL)."
    PUBLIC
    "Only the owner can mint a short-lived download URL."
    PRIVATE
}

enum UploadStatus {
    "The slot exists; bytes have not been verified yet."
    PENDING
    "Bytes are verified and the file is servable."
    READY
}

type Upload {
    id: Id!
    contentType: String!
    "Declared at create time; the actual byte count once READY."
    sizeBytes: Int!
    visibility: UploadVisibility!
    status: UploadStatus!
    createdTime: Instant!
}

"Everything the client needs to PUT the file bytes."
type UploadSlot {
    uploadId: Id!
    "Absolute signed GCS URL (gcs mode) or a /upload path on the storage function (local mode)."
    uploadUrl: String!
    "Headers to send verbatim on the PUT, JSON-encoded ({\"Content-Type\": ...})."
    headersJson: String!
    upload: Upload!
}

input CreateUploadInput {
    idempotencyKey: String!
    fields: CreateUploadFields!
}

input CreateUploadFields {
    "Must be on the kernel's content-type allowlist (Services/Storage/StorageConfig.ts)."
    contentType: String!
    "Declared size; validated against the kernel's max, re-checked at finalize."
    sizeBytes: Int!
    visibility: UploadVisibility!
}

input FinalizeUploadInput {
    uploadId: Id!
}

input DeleteUploadInput {
    uploadId: Id!
}

"A resolved download URL. PRIVATE URLs expire; PUBLIC URLs are stable."
type FileUrl {
    url: String!
}
# Shared cursor-pagination contract. Every list query takes a domain
# *ConnectionInput wrapping this ConnectionInput plus optional filters,
# and returns a domain *Connection with nodes + pageInfo.

input ConnectionInput {
    pagination: PaginationInput!
    sort: [SortOrderInput!]!
}

type PageInfo {
    hasPreviousPage: Boolean!
    hasNextPage: Boolean!
    startCursor: String
    endCursor: String
}

input PaginationInput {
    first: Int!
    after: String
}

input SortOrderInput {
    fieldName: String!
    direction: SortDirection!
}

enum SortDirection {
    asc
    desc
}
# Backend-driven forms. The backend builds complete form definitions
# (JSON Schema + UI schema + default data, each JSON-encoded) so clients
# render entity create/edit forms with zero frontend form code.

type SchemaForm {
    jsonSchema: String!
    uiSchema: String!
    defaultData: String!
}

input SchemaFormUpdateInput {
    objectId: Id!
}
# Globally unique, prefixed row IDs (for example "user_01H..."). Sent to clients as-is.
scalar Id

# Represents a point in time, encoded as an RFC 3339 / ISO 8601 UTC string.
# Format: "2026-04-14T22:58:03.000Z"
scalar Instant
