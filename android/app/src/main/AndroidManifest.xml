<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Sideloaded dev builds self-update through the platform's device
         update channel (update/UpdateChannel.kt); the system still shows
         its own confirmation sheet for every install. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Push notifications (push kernel). Requested at runtime only on the
         explicit enable in Settings, never at launch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Sandbox flavor talks to the local emulator stack over plain HTTP;
         deployed flavors only ever use HTTPS endpoints. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BaseApp"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Auth OAuth callback (twin of the iOS AUTH_URL_SCHEME
                 deep link): ${authScheme}://auth/callback -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="auth"
                    android:pathPrefix="/callback"
                    android:scheme="${authScheme}" />
            </intent-filter>
        </activity>

        <!-- PackageInstaller status sink for the self-updater; addressed
             with an explicit component, so no intent filter. -->
        <receiver
            android:name=".update.UpdateInstaller$UpdateInstallReceiver"
            android:exported="false" />

        <!-- FCM entry point: token rotation + message display (push kernel).
             FirebaseApp is initialized manually from stamped config, not by
             the google-services plugin (see components/PushComponent.kt). -->
        <service
            android:name=".push.AppMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
