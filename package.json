{
    "name": "repobot-base",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "workspaces": [
        "firebase/functions",
        "web/core",
        "web/design-system",
        "web/app"
    ],
    "scripts": {
        "dev:db": "bash scripts/dev-db.sh",
        "dev:db:reset": "bash scripts/dev-db.sh --reset",
        "dev:db:test": "bash scripts/dev-db.sh --test",
        "dev:up": "bash scripts/dev-up.sh",
        "dev:down": "bash scripts/dev-down.sh",
        "dev:status": "bash scripts/dev-status.sh",
        "dev:logs": "bash scripts/dev-logs.sh",
        "dev:pack": "bash scripts/dev-pack.sh",
        "bootstrap:env": "node scripts/bootstrap-env.mjs",
        "migrate": "npm --workspace firebase/functions run migrate",
        "migrate:test": "npm --workspace firebase/functions run migrate:test",
        "codegen": "bash scripts/codegen.sh",
        "codegen:design-manifest": "node scripts/generate-design-manifest.mjs",
        "codegen:landing-reference": "node scripts/generate-landing-reference.mjs",
        "codegen:web-app-reference": "node scripts/generate-web-app-reference.mjs",
        "graphql:ios:fetch": "cd ios && ./graphql-fetch-schema.sh",
        "graphql:ios:generate": "cd ios && ./graphql-generate.sh",
        "graphql:ios:prebuild": "cd ios && ./prebuild.sh",
        "build:ios": "xcodebuild -project ios/App.xcodeproj -scheme Sandbox -destination 'generic/platform=iOS Simulator' CODE_SIGNING_ALLOWED=NO build",
        "check:ios": "npm run build:ios",
        "graphql:android:fetch": "cd android && ./graphql-fetch-schema.sh",
        "graphql:android:prebuild": "cd android && ./prebuild.sh",
        "build:android": "cd android && ./gradlew :app:assembleSandboxDebug",
        "check:android": "cd android && ./gradlew :app:assembleSandboxDebug :app:testSandboxDebugUnitTest",
        "check:all": "bash scripts/check-all.sh",
        "check:web": "bash scripts/check-web.sh",
        "typecheck": "npm --workspace web/core run typecheck && npm --workspace web/design-system run typecheck && npm --workspace web/app run typecheck",
        "check:docs": "node scripts/check-doc-paths.mjs",
        "test:compose": "node --test scripts/compose-pack.test.mjs",
        "check:agent-maps": "node scripts/check-agent-maps.mjs",
        "test:agent-maps": "node --test scripts/generate-agent-map.test.mjs",
        "test:dep-cache": "node --test scripts/dep-cache-coverage.test.mjs",
        "test:dev-ports": "node --test scripts/dev-up-ports.test.mjs",
        "scaffold:ia": "node scripts/scaffold-ia.mjs",
        "test:scaffold": "node --test scripts/scaffold-ia.test.mjs",
        "seo:generate": "node scripts/generate-seo-files.mjs",
        "test:seo": "node --test scripts/generate-seo-files.test.mjs",
        "theme:import": "node scripts/import-theme.mjs",
        "test:theme-import": "node --test scripts/import-theme.test.mjs",
        "brief:check": "node scripts/brief/check.mjs",
        "test:brief": "node --test scripts/brief/check.test.mjs",
        "page:check": "node scripts/page-check.mjs",
        "test:page-check": "node --test scripts/page-check.test.mjs",
        "verify:pack-registers": "node scripts/verify-pack-registers.mjs",
        "verify:preview-parity": "node scripts/verify-preview-parity.mjs",
        "test:pinned-tests": "node --test scripts/verify-pinned-tests.test.mjs",
        "test:capability-declarations": "node --test scripts/verify-capability-declarations.test.mjs",
        "image": "node scripts/brand/image-tool.mjs",
        "brand:generate": "node scripts/brand/image-tool.mjs generate",
        "test:image": "node --test scripts/brand/image-tool.test.mjs",
        "test:check-scope": "node --test scripts/lib/check-scope.test.mjs",
        "test:manifest-routes": "node --test scripts/verify-manifest-routes.test.mjs",
        "test:shell-containment": "node --test scripts/verify-shell-containment.test.mjs",
        "test:auth-surface": "node --test scripts/verify-auth-surface.test.mjs",
        "test:auth-plumbing": "node --test scripts/check-auth-plumbing.test.mjs",
        "test:pack-integrity": "node --test scripts/verify-pack-integrity.test.mjs",
        "test:bake-web": "node --test scripts/bake-web-bundles.test.mjs",
        "test:shop-integration": "node --test scripts/verify-shop-integration.test.mjs",
        "test:web": "npm --workspace web/app run test",
        "test": "npm --workspace firebase/functions run test",
        "storybook": "npm --workspace web/design-system run storybook",
        "deploy:dev": "bash scripts/deploy.sh dev",
        "deploy:prod": "bash scripts/deploy.sh prod",
        "prepare": "bash scripts/install-git-hooks.sh || true"
    },
    "engines": {
        "node": ">=20"
    },
    "devDependencies": {
        "embedded-postgres": "16.14.0-beta.17",
        "firebase-tools": "13.35.1",
        "prettier": "3.9.5",
        "sharp": "^0.35.3"
    }
}
