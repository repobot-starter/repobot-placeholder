{
    "magicLink": {
        "subject": "Your sign-in code",
        "html": "<div style=\"background:#f5f6f8;padding:32px 16px;font-family:-apple-system,'Segoe UI',Arial,Helvetica,sans-serif\">\n<div style=\"max-width:440px;margin:0 auto;background:#ffffff;border:1px solid #e5e8ec;border-radius:12px;padding:32px\">\n<p style=\"margin:0 0 24px;font-size:20px;font-weight:bold;color:#1f6feb\">{{ .AppName }}</p>\n<h2 style=\"margin:0 0 8px;font-size:22px;color:#1a1f26\">Sign in</h2>\n<p style=\"margin:0 0 16px;font-size:15px;color:#4b5563\">Enter this code in the app to sign in:</p>\n<p style=\"margin:0 0 16px;font-size:32px;font-weight:bold;letter-spacing:6px;font-family:monospace;color:#1a1f26\">{{ .Token }}</p>\n<p style=\"margin:0 0 24px;font-size:14px;color:#4b5563\">Or use this link: <a href=\"{{ .ConfirmationURL }}\" style=\"color:#1f6feb\">{{ .ConfirmationURL }}</a></p>\n<p style=\"margin:0;font-size:13px;color:#8a919c\">If you didn't request this, you can ignore this email.</p>\n</div>\n</div>"
    },
    "confirmation": {
        "subject": "Confirm your email",
        "html": "<div style=\"background:#f5f6f8;padding:32px 16px;font-family:-apple-system,'Segoe UI',Arial,Helvetica,sans-serif\">\n<div style=\"max-width:440px;margin:0 auto;background:#ffffff;border:1px solid #e5e8ec;border-radius:12px;padding:32px\">\n<p style=\"margin:0 0 24px;font-size:20px;font-weight:bold;color:#1f6feb\">{{ .AppName }}</p>\n<h2 style=\"margin:0 0 8px;font-size:22px;color:#1a1f26\">Confirm your email</h2>\n<p style=\"margin:0 0 16px;font-size:15px;color:#4b5563\">Click the button below to verify your email address. You'll be signed in automatically.</p>\n<p style=\"margin:0 0 24px\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#1f6feb;color:#ffffff;font-size:15px;font-weight:bold;text-decoration:none;padding:12px 28px;border-radius:8px\">Verify email</a></p>\n<p style=\"margin:0 0 24px;font-size:13px;color:#8a919c\">If the button doesn't work, copy and paste this link into your browser:<br><a href=\"{{ .ConfirmationURL }}\" style=\"color:#1f6feb;word-break:break-all\">{{ .ConfirmationURL }}</a></p>\n<p style=\"margin:0;font-size:13px;color:#8a919c\">If you didn't request this, you can ignore this email.</p>\n</div>\n</div>"
    },
    "recovery": {
        "subject": "Your password reset code",
        "html": "<div style=\"background:#f5f6f8;padding:32px 16px;font-family:-apple-system,'Segoe UI',Arial,Helvetica,sans-serif\">\n<div style=\"max-width:440px;margin:0 auto;background:#ffffff;border:1px solid #e5e8ec;border-radius:12px;padding:32px\">\n<p style=\"margin:0 0 24px;font-size:20px;font-weight:bold;color:#1f6feb\">{{ .AppName }}</p>\n<h2 style=\"margin:0 0 8px;font-size:22px;color:#1a1f26\">Reset your password</h2>\n<p style=\"margin:0 0 16px;font-size:15px;color:#4b5563\">Enter this code in the app to reset your password:</p>\n<p style=\"margin:0 0 16px;font-size:32px;font-weight:bold;letter-spacing:6px;font-family:monospace;color:#1a1f26\">{{ .Token }}</p>\n<p style=\"margin:0 0 24px;font-size:14px;color:#4b5563\">Or use this link: <a href=\"{{ .ConfirmationURL }}\" style=\"color:#1f6feb\">{{ .ConfirmationURL }}</a></p>\n<p style=\"margin:0;font-size:13px;color:#8a919c\">If you didn't request this, you can ignore this email.</p>\n</div>\n</div>"
    }
}
