<section class="featured-collection">
  {% if section.settings.eyebrow != blank %}
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
  {% endif %}
  <h2 class="featured-collection__title">{{ section.settings.title }}</h2>
  <div class="product-grid">
    {% assign collection = collections[section.settings.collection] %}
    {% if collection.products.size > 0 %}
      {% for product in collection.products limit: section.settings.limit %}
        <a class="product-card" href="{{ product.url }}">
          {% if product.featured_image %}
            <img
              src="{{ product.featured_image | image_url: width: 480 }}"
              alt="{{ product.featured_image.alt | escape }}"
              loading="lazy"
              width="480"
              height="{{ 480 | divided_by: product.featured_image.aspect_ratio | ceil }}"
            >
          {% endif %}
          <h3>{{ product.title }}</h3>
          {% render 'price', product: product %}
        </a>
      {% endfor %}
    {% else %}
      {%- comment -%}
        Onboarding demo cards: shown until a collection with products is
        bound, so a fresh store still previews like the finished thing.
        Imagery ships with the theme; copy mirrors the demo catalog.
      {%- endcomment -%}
      {% for demo_index in (1..3) %}
        {% case demo_index %}
          {% when 1 %}
            {% assign demo_image = 'demo-coat.jpg' %}
            {% assign demo_title = 'sections.featured_collection.demo_coat_title' %}
            {% assign demo_price = 49800 %}
          {% when 2 %}
            {% assign demo_image = 'demo-knit.jpg' %}
            {% assign demo_title = 'sections.featured_collection.demo_knit_title' %}
            {% assign demo_price = 16800 %}
          {% else %}
            {% assign demo_image = 'demo-tote.jpg' %}
            {% assign demo_title = 'sections.featured_collection.demo_tote_title' %}
            {% assign demo_price = 28800 %}
        {% endcase %}
        <a class="product-card" href="{{ routes.all_products_collection_url }}">
          <img
            src="{{ demo_image | asset_url }}"
            alt="{{ demo_title | t }}"
            loading="lazy"
            width="480"
            height="480"
          >
          <h3>{{ demo_title | t }}</h3>
          <span class="price">{{ demo_price | money }}</span>
        </a>
      {% endfor %}
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "In store now"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Shop the essentials"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
