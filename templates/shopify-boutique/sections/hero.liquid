<section class="hero">
  <div class="hero__content">
    {% if section.settings.eyebrow != blank %}
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    {% endif %}
    <h1 class="hero__title">{{ section.settings.title }}</h1>
    <p class="hero__subtitle">{{ section.settings.subtitle }}</p>
    <div class="hero__actions">
      {% if section.settings.cta_label != blank %}
        <a class="button" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">
          {{- section.settings.cta_label -}}
        </a>
      {% endif %}
      {%- comment -%}
        Fallback lives here, not in the schema: Shopify only allows
        /collections and /collections/all as url-setting defaults.
      {%- endcomment -%}
      {% if section.settings.secondary_cta_label != blank %}
        <a class="button button--ghost" href="{{ section.settings.secondary_cta_link | default: '#lookbook' }}">
          {{- section.settings.secondary_cta_label -}}
        </a>
      {% endif %}
    </div>
  </div>
  <div class="hero__media" aria-hidden="true">
    {%- comment -%}
      image_picker settings can't carry defaults, so the demo apparel
      photograph ships as a theme asset and renders whenever no image has
      been picked.
    {%- endcomment -%}
    {%- if section.settings.image != blank -%}
      <img
        class="hero__image"
        src="{{ section.settings.image | image_url: width: 1600 }}"
        alt="{{ section.settings.image.alt | default: shop.name | escape }}"
        width="1600"
        height="{{ 1600 | divided_by: section.settings.image.aspect_ratio | ceil }}"
        loading="eager"
      >
    {%- else -%}
      <img
        class="hero__image"
        src="{{ 'hero-pieces.jpg' | asset_url }}"
        alt=""
        width="1600"
        height="1067"
        loading="eager"
      >
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Falls back to the theme's demo apparel photograph when empty."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "New season"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Pieces made to keep"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Timeless fabrics. Thoughtful details. Considered apparel and accessories, cut from natural cloth and made to last."
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Primary button label",
      "default": "Shop new arrivals"
    },
    {
      "type": "url",
      "id": "secondary_cta_link",
      "label": "Secondary button link"
    },
    {
      "type": "text",
      "id": "secondary_cta_label",
      "label": "Secondary button label",
      "default": "Explore the lookbook"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
