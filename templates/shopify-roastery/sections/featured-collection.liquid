<section class="featured-collection">
  <h2 class="section-heading">{{ section.settings.title }}</h2>
  <div class="product-grid">
    {% assign collection = collections[section.settings.collection] %}
    {% if collection.products.size > 0 %}
      {% for product in collection.products limit: section.settings.limit %}
        <div class="product-card">
          {%- comment -%}
            Roast-level badge from tags like "roast-dark" ("roast-of-the-month"
            is a merchandising tag, not a roast level).
          {%- endcomment -%}
          {% assign roast_badge = blank %}
          {% for tag in product.tags %}
            {% assign tag_down = tag | downcase %}
            {% if tag_down contains 'roast-' and tag_down != 'roast-of-the-month' %}
              {% assign roast_badge = tag_down | remove_first: 'roast-' | replace: '-', ' ' %}
              {% break %}
            {% endif %}
          {% endfor %}
          {% if roast_badge != blank %}
            <span class="product-card__badge">{{ roast_badge }}</span>
          {% endif %}
          <a class="product-card__link" href="{{ product.url }}">
            {% if product.featured_image %}
              <img
                src="{{ product.featured_image | image_url: width: 480 }}"
                alt="{{ product.featured_image.alt | escape }}"
                loading="lazy"
                width="480"
                height="{{ 480 | divided_by: product.featured_image.aspect_ratio | ceil }}"
              >
            {% endif %}
            <h3>{{ product.title }}</h3>
          </a>
          <div class="product-card__buy">
            {% render 'price', product: product %}
            <form method="post" action="{{ routes.cart_add_url }}">
              <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
              <button type="submit" class="product-card__add" {% unless product.available %}disabled{% endunless %}>
                {% if product.available %}
                  {{ 'products.product.add_to_cart' | t }}
                {% else %}
                  {{ 'products.product.sold_out' | t }}
                {% endif %}
              </button>
            </form>
          </div>
        </div>
      {% endfor %}
    {% else %}
      {%- comment -%}
        Onboarding demo cards: shown until a collection with products is
        bound, so a fresh store still previews like the finished thing.
        Imagery ships with the theme; copy mirrors the demo catalog.
      {%- endcomment -%}
      {% for demo_index in (1..3) %}
        {% case demo_index %}
          {% when 1 %}
            {% assign demo_image = 'demo-bag-light.jpg' %}
            {% assign demo_badge = 'light' %}
            {% assign demo_title = 'sections.featured_collection.demo_light_title' %}
            {% assign demo_notes = 'sections.featured_collection.demo_light_notes' %}
            {% assign demo_price = 2200 %}
          {% when 2 %}
            {% assign demo_image = 'demo-bag-medium.jpg' %}
            {% assign demo_badge = 'medium' %}
            {% assign demo_title = 'sections.featured_collection.demo_medium_title' %}
            {% assign demo_notes = 'sections.featured_collection.demo_medium_notes' %}
            {% assign demo_price = 1950 %}
          {% else %}
            {% assign demo_image = 'demo-bag-dark.jpg' %}
            {% assign demo_badge = 'dark' %}
            {% assign demo_title = 'sections.featured_collection.demo_dark_title' %}
            {% assign demo_notes = 'sections.featured_collection.demo_dark_notes' %}
            {% assign demo_price = 1900 %}
        {% endcase %}
        <div class="product-card">
          <span class="product-card__badge">{{ demo_badge }}</span>
          <a class="product-card__link" href="{{ routes.all_products_collection_url }}">
            <img
              src="{{ demo_image | asset_url }}"
              alt="{{ demo_title | t }}"
              loading="lazy"
              width="480"
              height="480"
            >
            <h3>{{ demo_title | t }}</h3>
          </a>
          <p class="product-card__notes">{{ demo_notes | t }}</p>
          <div class="product-card__buy">
            <span class="price">{{ demo_price | money }}</span>
            <a class="button product-card__add" href="{{ routes.all_products_collection_url }}">
              {{ 'sections.featured_collection.shop_cta' | t }}
            </a>
          </div>
        </div>
      {% endfor %}
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "On the shelf this week"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
