<section class="hero">
  <div class="hero__media" aria-hidden="true">
    {%- comment -%}
      image_picker settings can't carry defaults, so the demo hero art ships
      as a theme asset and renders whenever no image has been picked.
    {%- endcomment -%}
    {%- if section.settings.image != blank -%}
      <img
        class="hero__image"
        src="{{ section.settings.image | image_url: width: 2400 }}"
        alt="{{ section.settings.image.alt | escape }}"
        width="2400"
        height="{{ 2400 | divided_by: section.settings.image.aspect_ratio | ceil }}"
        loading="eager"
      >
    {%- else -%}
      <img
        class="hero__image"
        src="{{ 'hero-roast.jpg' | asset_url }}"
        alt=""
        width="2400"
        height="1350"
        loading="eager"
      >
    {%- endif -%}
  </div>
  <div class="hero__content">
    {% if section.settings.eyebrow != blank %}
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <h1 class="hero__title">{{ section.settings.title }}</h1>
    <p class="hero__subtitle">{{ section.settings.subtitle }}</p>
    <div class="hero__actions">
      {% if section.settings.cta_link != blank %}
        <a class="button" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }}</a>
      {% endif %}
      {%- comment -%}
        Fallback lives here, not in the schema: Shopify only allows
        /collections and /collections/all as url-setting defaults.
      {%- endcomment -%}
      {%- assign secondary_cta_url = section.settings.secondary_cta_link | default: '/pages/how-we-roast' -%}
      {% if secondary_cta_url != blank %}
        <a class="button button--ghost" href="{{ secondary_cta_url }}">
          {{ section.settings.secondary_cta_label }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image",
      "info": "Falls back to the theme's demo roastery photograph when empty."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Small batch · Roasted weekly"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Roasted Tuesdays. At your door by the weekend."
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "This month's roast: Cloud Forest, Huila — a washed Colombian lot with dark-chocolate depth and a toasted-hazelnut finish."
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Primary button link",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Primary button label",
      "default": "Shop coffee"
    },
    {
      "type": "url",
      "id": "secondary_cta_link",
      "label": "Secondary button link"
    },
    {
      "type": "text",
      "id": "secondary_cta_label",
      "label": "Secondary button label",
      "default": "How we roast"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
