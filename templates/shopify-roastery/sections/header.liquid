<header class="site-header">
  <a class="site-header__brand" href="{{ routes.root_url }}">
    {%- if section.settings.logo != blank -%}
      <img
        class="site-header__logo"
        src="{{ section.settings.logo | image_url: width: 360 }}"
        alt="{{ section.settings.logo.alt | default: shop.name | escape }}"
        width="180"
        height="{{ 180 | divided_by: section.settings.logo.aspect_ratio | ceil }}"
      >
    {%- else -%}
      <svg class="site-header__mark" viewBox="0 0 40 40" fill="none" aria-hidden="true" focusable="false">
        <circle cx="20" cy="20" r="18.5" stroke="currentColor" stroke-width="2"/>
        <path d="M9 26.5 16.5 15l4.5 6.5 3-4L31 26.5z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" fill="none"/>
      </svg>
      <span class="site-header__wordmark">
        <span class="site-header__name">{{ section.settings.logo_text | default: shop.name }}</span>
        {%- if section.settings.logo_subtext != blank -%}
          <span class="site-header__subname">{{ section.settings.logo_subtext }}</span>
        {%- endif -%}
      </span>
    {%- endif -%}
  </a>
  <nav class="site-header__nav" role="navigation">
    {% if section.settings.menu != blank %}
      {% for link in section.settings.menu.links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    {% else %}
      {%- comment -%}
        Fallback nav when no menu is picked: only routes that exist on any
        store — the all-products collection and homepage section anchors.
      {%- endcomment -%}
      <a href="{{ routes.all_products_collection_url }}">{{ 'sections.header.nav_shop' | t }}</a>
      <a href="{{ routes.root_url }}#subscribe">{{ 'sections.header.nav_subscribe' | t }}</a>
      <a href="{{ routes.root_url }}#about">{{ 'sections.header.nav_about' | t }}</a>
    {% endif %}
  </nav>
  <a class="site-header__cart" href="{{ routes.cart_url }}">
    {{ 'sections.header.cart' | t }} ({{ cart.item_count }})
  </a>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text",
      "info": "Falls back to the store name when empty.",
      "default": "High Ridge"
    },
    {
      "type": "text",
      "id": "logo_subtext",
      "label": "Logo secondary line",
      "default": "Coffee Roasters"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "info": "When empty, the header shows Shop / Subscribe / About."
    }
  ]
}
{% endschema %}
