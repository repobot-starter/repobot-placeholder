<section class="hero">
  <div class="hero__media" aria-hidden="true">
    {%- comment -%}
      image_picker settings can't carry defaults, so the demo room scene
      ships as a theme asset and renders whenever no image has been picked.
    {%- endcomment -%}
    {% if section.settings.image %}
      <img
        src="{{ section.settings.image | image_url: width: 1800 }}"
        alt="{{ section.settings.image.alt | escape }}"
        width="1800"
        height="{{ 1800 | divided_by: section.settings.image.aspect_ratio | ceil }}"
      >
    {% else %}
      <img
        src="{{ 'hero-room.jpg' | asset_url }}"
        alt=""
        width="1800"
        height="1013"
        loading="eager"
      >
    {% endif %}
  </div>
  <div class="hero__panel">
    {% if section.settings.eyebrow != blank %}
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <h1 class="hero__title">{{ section.settings.title }}</h1>
    <p class="hero__subtitle">{{ section.settings.subtitle }}</p>
    <div class="hero__actions">
      {% if section.settings.cta_link != blank %}
        <a class="button" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }}</a>
      {% endif %}
      {%- comment -%}
        Fallback lives here, not in the schema: Shopify only allows
        /collections and /collections/all as url-setting defaults.
      {%- endcomment -%}
      {%- assign secondary_cta_url = section.settings.secondary_cta_link | default: '#materials' -%}
      {% if secondary_cta_url != blank %}
        <a class="button button--ghost" href="{{ secondary_cta_url }}">
          {{ section.settings.secondary_cta_label }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Room scene image",
      "info": "Falls back to the theme's demo room scene when empty."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Furniture that settles in"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Made for rooms you live in"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Architectural pieces in honest materials — solid wood, real joinery, and fabrics that wear their years well."
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Primary button link",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Primary button label",
      "default": "Shop new arrivals"
    },
    {
      "type": "url",
      "id": "secondary_cta_link",
      "label": "Secondary button link"
    },
    {
      "type": "text",
      "id": "secondary_cta_label",
      "label": "Secondary button label",
      "default": "Browse materials"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
