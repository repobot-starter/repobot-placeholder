<section class="featured-collection" id="featured">
  <h2>{{ section.settings.title }}</h2>
  <div class="product-grid">
    {% assign collection = collections[section.settings.collection] %}
    {% if collection.products.size > 0 %}
      {% for product in collection.products limit: section.settings.limit %}
        <div class="product-card">
          <a class="product-card__link" href="{{ product.url }}">
            {% if product.featured_image %}
              <img
                src="{{ product.featured_image | image_url: width: 480 }}"
                alt="{{ product.featured_image.alt | escape }}"
                loading="lazy"
                width="480"
                height="{{ 480 | divided_by: product.featured_image.aspect_ratio | ceil }}"
              >
            {% endif %}
            <h3>{{ product.title }}</h3>
          </a>
          <div class="product-card__buy">
            {% render 'price', product: product %}
            <form method="post" action="{{ routes.cart_add_url }}">
              <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
              <button type="submit" class="product-card__add" {% unless product.available %}disabled{% endunless %}>
                {% if product.available %}
                  {{ 'products.product.add_to_cart' | t }}
                {% else %}
                  {{ 'products.product.sold_out' | t }}
                {% endif %}
              </button>
            </form>
          </div>
        </div>
      {% endfor %}
    {% else %}
      {%- comment -%}
        Onboarding demo cards: shown until a collection with products is
        bound, so a fresh store still previews like the finished thing.
        Imagery ships with the theme; copy mirrors the demo catalog.
      {%- endcomment -%}
      {% for demo_index in (1..3) %}
        {% case demo_index %}
          {% when 1 %}
            {% assign demo_image = 'demo-backpack.jpg' %}
            {% assign demo_badge = 'sections.featured_collection.demo_badge_bestseller' %}
            {% assign demo_title = 'sections.featured_collection.demo_backpack_title' %}
            {% assign demo_notes = 'sections.featured_collection.demo_backpack_notes' %}
            {% assign demo_price = 12900 %}
          {% when 2 %}
            {% assign demo_image = 'demo-sling.jpg' %}
            {% assign demo_badge = 'sections.featured_collection.demo_badge_new' %}
            {% assign demo_title = 'sections.featured_collection.demo_sling_title' %}
            {% assign demo_notes = 'sections.featured_collection.demo_sling_notes' %}
            {% assign demo_price = 7800 %}
          {% else %}
            {% assign demo_image = 'demo-duffel.jpg' %}
            {% assign demo_badge = blank %}
            {% assign demo_title = 'sections.featured_collection.demo_duffel_title' %}
            {% assign demo_notes = 'sections.featured_collection.demo_duffel_notes' %}
            {% assign demo_price = 14900 %}
        {% endcase %}
        <div class="product-card">
          {% if demo_badge != blank %}
            <span class="product-card__badge">{{ demo_badge | t }}</span>
          {% endif %}
          <a class="product-card__link" href="{{ routes.all_products_collection_url }}">
            <img
              src="{{ demo_image | asset_url }}"
              alt="{{ demo_title | t }}"
              loading="lazy"
              width="480"
              height="480"
            >
            <h3>{{ demo_title | t }}</h3>
          </a>
          <p class="product-card__notes">{{ demo_notes | t }}</p>
          <div class="product-card__buy">
            <span class="price">{{ demo_price | money }}</span>
            <a class="product-card__add" href="{{ routes.all_products_collection_url }}">
              {{ 'sections.featured_collection.shop_cta' | t }}
            </a>
          </div>
        </div>
      {% endfor %}
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Featured products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
