<section class="hero">
  <div class="hero__content">
    {% if section.settings.eyebrow != blank %}
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <h1 class="hero__title">{{ section.settings.title }}</h1>
    <p class="hero__subtitle">{{ section.settings.subtitle }}</p>
    <div class="hero__actions">
      {% if section.settings.cta_link != blank %}
        <a class="button" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }}</a>
      {% endif %}
      {% if section.settings.secondary_cta_link != blank %}
        <a class="button button--ghost" href="{{ section.settings.secondary_cta_link }}">
          {{ section.settings.secondary_cta_label }}
        </a>
      {% endif %}
    </div>
  </div>
  <div class="hero__media" aria-hidden="true">
    {%- comment -%}
      image_picker settings can't carry defaults, so the demo shelf photograph
      ships as a theme asset and renders whenever no image has been picked.
    {%- endcomment -%}
    {%- if section.settings.image != blank -%}
      <img
        class="hero__image"
        src="{{ section.settings.image | image_url: width: 1600 }}"
        alt="{{ section.settings.image.alt | default: shop.name | escape }}"
        width="1600"
        height="{{ 1600 | divided_by: section.settings.image.aspect_ratio | ceil }}"
        loading="eager"
      >
    {%- else -%}
      <img
        class="hero__image"
        src="{{ 'hero-routine.jpg' | asset_url }}"
        alt=""
        width="1600"
        height="900"
        loading="eager"
      >
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Falls back to the theme's demo shelf photograph when empty."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Clinically simple"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Three steps. Morning and night."
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Short ingredient lists at working concentrations, in the order your skin actually uses them. Nothing to decode, nothing to skip."
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Primary button link",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Primary button label",
      "default": "Shop the routine"
    },
    {
      "type": "url",
      "id": "secondary_cta_link",
      "label": "Secondary button link"
    },
    {
      "type": "text",
      "id": "secondary_cta_label",
      "label": "Secondary button label",
      "default": "Learn the ingredients"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
