    "landing": {
        "$comment": "Doc-aware pack pages: routes maps '/' and '/book' to the page ids their configs merge under (web/app/src/View/Dj/DjPage.tsx, useSitePageConfig); pages seed the layout skeletons — ids match djLanding.ts, and the hero badge plus the next-set banner are computed from the sets at render time. Mixes and Dates are the pack's bespoke surfaces (the hybrid mix players, the computed dates table) and stay outside the document merge. style must ride the overlay; the preset is mono-utility WORN ACHROMATIC — the style overrides pin accent to the register's own text ink, so the surface is paper-on-ink in dark and ink-on-paper in light, deliberately apart from broadside's printed poster and marquee's stage night.",
        "style": {
            "preset": "mono-utility",
            "overrides": {
                "--marketing-color-accent": "var(--marketing-color-text)",
                "--marketing-color-accentSoft": "color-mix(in srgb, var(--marketing-color-text) 14%, transparent)",
                "--marketing-color-onAccent": "var(--marketing-color-pageBg)"
            }
        },
        "routes": {
            "/": "home",
            "/book": "book"
        },
        "pages": {
            "home": {
                "sections": [
