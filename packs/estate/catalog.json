    "landing": {
        "$comment": "Doc-aware pack pages: routes maps each pack route to the page id its config merges under (web/app/src/View/Estate/EstatePage.tsx, useSitePageConfig). pages seeds each page's layout skeleton \u2014 ids match estateLanding.ts; the platform's structural editor edits these. The preset is brownstone (the residential register: limestone paper, deep navy serif, brick accent, stone grain) \u2014 the open-house folder from a good agency, deliberately apart from sitework's jobsite clipboard.",
        "style": { "preset": "brownstone" },
        "routes": {
            "/": "home",
            "/listings": "listings",
            "/neighborhoods": "neighborhoods",
            "/about": "about",
