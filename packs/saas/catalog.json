{
    "key": "saas",
    "templateKey": "repobot-saas",
    "title": "SaaS Foundation",
    "description": "A complete SaaS skeleton: marketing landing and pricing pages, sign-up and sign-in, and a signed-in dashboard with an overview, data tables, and account settings.",
    "marketingExampleTitle": "SaaS web application",
    "homePath": "/",
    "previewPath": "/overview",
    "homeViewDir": "web/app/src/View/Site",
    "base": "app",
    "isBase": true,
    "clientOnly": false,
    "capabilities": ["AUTH", "DATABASE", "EMAIL", "IOS", "ANDROID", "STORAGE", "JOBS", "AI", "DOCUMENTS"],
    "authMethods": ["email-code", "password"],
    "theme": {
        "$comment": "The monolith register's overlay: mode dark opens the site on true black (the appearance toggle swaps to the white-negative variant \u2014 the inversion is the art direction), no fontFamily so the preset's own display voice (Space Grotesk) survives (a pack font override would flatten the marketing display face too), and the brand resolves to ink-on-ground so CTAs and app chrome read as hard white/black plates. The palette de-tints the whole app: the kernel's blue-gray dark surfaces become true black with neutral-gray structure, and the light mode drops the kernel's blue cast \u2014 the product is black and white, the same conviction as the register. Charts speak in line-work grays \u2014 the register has no accent hue to lean on.",
        "mode": "dark",
        "character": "plain",
        "brand": { "primary": "#0a0a0a", "primaryDark": "#ffffff" },
        "navigation": { "variant": "centered" },
        "palette": {
            "background": "#fafafa",
            "backgroundDark": "#000000",
            "surface": "#ffffff",
            "surfaceDark": "#0d0d0d",
            "surfaceHover": "#f0f0f0",
            "surfaceHoverDark": "#1a1a1a",
            "border": "#e4e4e4",
            "borderDark": "#262626",
            "textPrimary": "#111111",
            "textPrimaryDark": "#f5f5f5",
            "textSecondary": "#5c5c5c",
            "textSecondaryDark": "#9c9c9c",
            "muted": "#f0f0f0",
            "mutedDark": "#161616",
            "input": "#e4e4e4",
            "inputDark": "#2e2e2e",
            "skeleton": "#ececec",
            "skeletonDark": "#1a1a1a",
            "charts": ["#0a0a0a", "#5e5e5e", "#9c9c9c", "#333333", "#7a7a7a", "#c4c4c4"],
            "chartsDark": ["#ffffff", "#b0b0b0", "#7a7a7a", "#e0e0e0", "#949494", "#565656"]
        }
    },
    "isDefault": false,
    "contentContract": {
        "$comment": "The pack's content slots, as data (packs/README.md 'Content contract'). The saas pack is manifest-driven: contentContract.module IS the project manifest (compose stamps packs/saas/repobot.project.json to the repo root), so the runtime reads it with JSON.parse and writes edits back into the parsed tree — no TS module involved. Slot paths therefore walk the manifest's REAL structure: marketing.pages[0]=home, [1]=features, [2]=pricing, each page's copy under landing.sections[i].content with the section order fixed by this catalog's landing seeds. Labels are declared because the deep paths all leaf on the same words (headline, items) — the panel needs page-scoped names. Product media slots expect real dashboard captures processed by `npm run image -- responsive` into web/app/public/saas/ — the hero capture and bento crops are what make the page read as a real product (the fragments slot feeds the panel-collage hero when a remix rolls back to it). Tier `monthly` (number) and `features` (text[]) item fields are documentation: the runtime's collection item vocabulary is text|media, so they don't surface in the panel.",
        "module": "repobot.project.json",
        "slots": {
            "marketing.siteName": { "kind": "text", "label": "Site name" },
            "marketing.pages[0].landing.sections[0].content.headline": {
                "kind": "text",
                "label": "Home hero headline"
            },
            "marketing.pages[0].landing.sections[0].content.subheadline": {
                "kind": "text",
                "label": "Home hero subheadline"
            },
            "marketing.pages[0].landing.sections[0].content.media": {
                "kind": "media",
                "label": "Home hero screenshot"
            },
            "marketing.pages[0].landing.sections[0].content.fragments": {
                "kind": "media[]",
                "min": 2,
                "label": "Home hero fragments"
            },
            "marketing.pages[0].landing.sections[1].content.items": {
                "kind": "text[]",
                "min": 5,
                "label": "Home social proof"
            },
            "marketing.pages[0].landing.sections[2].content.features": {
                "kind": "collection",
                "min": 5,
                "label": "Home features",
                "item": {
                    "title": { "kind": "text" },
                    "description": { "kind": "text" }
                }
            },
            "marketing.pages[0].landing.sections[3].content.highlights": {
                "kind": "collection",
                "min": 2,
                "label": "Home highlights",
                "item": {
                    "headline": { "kind": "text" },
                    "body": { "kind": "text" },
                    "media": { "kind": "media" }
                }
            },
            "marketing.pages[0].landing.sections[4].content.quotes": {
                "kind": "collection",
                "min": 3,
                "label": "Home testimonials",
                "item": {
                    "quote": { "kind": "text" },
                    "author": { "kind": "text" },
                    "title": { "kind": "text" }
                }
            },
            "marketing.pages[0].landing.sections[5].content.items": {
                "kind": "collection",
                "min": 3,
                "label": "Home FAQ",
                "item": {
                    "question": { "kind": "text" },
                    "answer": { "kind": "text" }
                }
            },
            "marketing.pages[1].landing.sections[0].content.headline": {
                "kind": "text",
                "label": "Features hero headline"
            },
            "marketing.pages[1].landing.sections[0].content.subheadline": {
                "kind": "text",
                "label": "Features hero subheadline"
            },
            "marketing.pages[1].landing.sections[1].content.features": {
                "kind": "collection",
                "min": 6,
                "label": "Feature list",
                "item": {
                    "title": { "kind": "text" },
                    "description": { "kind": "text" }
                }
            },
            "marketing.pages[1].landing.sections[2].content.highlights": {
                "kind": "collection",
                "min": 3,
                "label": "Feature highlights",
                "item": {
                    "headline": { "kind": "text" },
                    "body": { "kind": "text" },
                    "media": { "kind": "media" }
                }
            },
            "marketing.pages[2].landing.sections[0].content.headline": {
                "kind": "text",
                "label": "Pricing hero headline"
            },
            "marketing.pages[2].landing.sections[0].content.subheadline": {
                "kind": "text",
                "label": "Pricing hero subheadline"
            },
            "marketing.pages[2].landing.sections[1].content.metrics": {
                "kind": "collection",
                "min": 3,
                "label": "Pricing metrics",
                "item": {
                    "value": { "kind": "text" },
                    "label": { "kind": "text" }
                }
            },
            "marketing.pages[2].landing.sections[2].content.tiers": {
                "kind": "collection",
                "min": 2,
                "label": "Pricing tiers",
                "item": {
                    "name": { "kind": "text" },
                    "monthly": { "kind": "number" },
                    "description": { "kind": "text" },
                    "features": { "kind": "text[]", "min": 3 }
                }
            },
            "marketing.pages[2].landing.sections[3].content.items": {
                "kind": "collection",
                "min": 2,
                "label": "Pricing FAQ",
                "item": {
                    "question": { "kind": "text" },
                    "answer": { "kind": "text" }
                }
            }
        }
    },
    "landing": {
        "$comment": "Doc-aware marketing pages: routes maps each marketing route to the manifest page id its inline config lives under (marketing.pages in repobot.project.json, rendered by SitePage). pages seeds each page's layout skeleton — section ids follow the default id rule (the section type), matching how the layout document identifies inline-config sections. style rides the overlay the same way photography's does. The preset is monolith (the severe register: strict black and white, monumental statement type with stroke-only accent words, hairline frames, the capability ticker) — the edge-of-the-field voice.",
        "style": { "preset": "monolith" },
        "routes": {
            "/": "home",
            "/features": "features",
            "/pricing": "pricing"
        },
        "pages": {
            "home": {
                "sections": [
                    {
                        "id": "hero",
                        "type": "hero",
                        "variant": "statement"
                    },
                    {
                        "id": "social-proof",
                        "type": "social-proof",
                        "variant": "ticker"
                    },
                    {
                        "id": "feature-grid",
                        "type": "feature-grid",
                        "variant": "bento"
                    },
                    {
                        "id": "highlights",
                        "type": "highlights",
                        "variant": "alternating"
                    },
                    {
                        "id": "testimonials",
                        "type": "testimonials",
                        "variant": "quote-grid"
                    },
                    {
                        "id": "faq",
                        "type": "faq",
                        "variant": "accordion"
                    },
                    {
                        "id": "cta-banner",
                        "type": "cta-banner",
                        "variant": "full-bleed"
                    }
                ]
            },
            "features": {
                "sections": [
                    {
                        "id": "hero",
                        "type": "hero",
                        "variant": "statement"
                    },
                    {
                        "id": "feature-grid",
                        "type": "feature-grid",
                        "variant": "icon-list"
                    },
                    {
                        "id": "highlights",
                        "type": "highlights",
                        "variant": "alternating"
                    },
                    {
                        "id": "cta-banner",
                        "type": "cta-banner",
                        "variant": "full-bleed"
                    }
                ]
            },
            "pricing": {
                "sections": [
                    {
                        "id": "hero",
                        "type": "hero",
                        "variant": "statement"
                    },
                    {
                        "id": "social-proof",
                        "type": "social-proof",
                        "variant": "metrics-row"
                    },
                    {
                        "id": "pricing",
                        "type": "pricing",
                        "variant": "tiers"
                    },
                    {
                        "id": "faq",
                        "type": "faq",
                        "variant": "accordion"
                    },
                    {
                        "id": "cta-banner",
                        "type": "cta-banner",
                        "variant": "card"
                    }
                ]
            }
        }
    }
}
