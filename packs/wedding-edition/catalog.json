{
    "key": "wedding-edition",
    "templateKey": "repobot-wedding-edition",
    "title": "Weddings — The Late Edition",
    "description": "A loud wedding photographer's site styled as a New York tabloid: a front-page hero with a red dateline bar, banner headline, byline and halftone lead photo; newspaper stories under the fold that jump to the rolls; every wedding proofed as a 35mm contact sheet with grease-pencil picks and a lightbox; a flat-priced rate card with a classified ad and reader FAQ; testimonials run as letters to the editor; an inquiry form that asks for the date, venue, borough, guest count and vibe; and a private proofing room where couples and their families send print picks straight to the studio. A multi-page site edited in one content file.",
    "marketingExampleTitle": "Wedding photographer — tabloid edition",
    "category": "photography",
    "homePath": "/",
    "previewPath": "/wedding-edition",
    "homeViewDir": "web/app/src/View/WeddingEdition",
    "base": "content",
    "clientOnly": true,
    "capabilities": ["IOS", "ANDROID"],
    "isDefault": false,
    "platformServices": ["proofing"],
