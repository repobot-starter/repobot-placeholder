    "landing": {
        "$comment": "Doc-aware pack home: routes maps '/' to the page id its config merges under (web/app/src/View/Band/BandPage.tsx, useSitePageConfig); pages.home seeds the layout skeleton — ids match bandLanding.ts, and the hero badge plus the next-show banner title are computed from the shows at render time. Tour, Music, and Press are the pack's bespoke surfaces (the computed tour table, the hybrid audio players, the downloadable EPK) and stay outside the document merge, like the wedding pack's proofing room. style must ride the overlay: the compose merge keeps the kernel document's root style otherwise. The preset is broadside — the printed artifact: ink on paper, halftone dot screen, condensed caps, one oxblood accent — type-forward where marquee (the stage-night register) is photo-forward.",
        "style": {
            "preset": "broadside"
        },
        "routes": {
            "/": "home"
        },
        "pages": {
            "home": {
                "sections": [
                    { "id": "hero", "type": "hero", "variant": "statement" },
                    { "id": "marquee-frame", "type": "gallery", "variant": "sequence" },
                    { "id": "records", "type": "showcase", "variant": "collections" },
                    { "id": "intro", "type": "content-split", "variant": "media-right" },
                    { "id": "next-show", "type": "cta-banner", "variant": "full-bleed" },
                    { "id": "mailing-list", "type": "lead-form", "variant": "inline-email" }
                ]
            }
        }
