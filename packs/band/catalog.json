{
    "key": "band",
    "templateKey": "repobot-band",
    "title": "Band & artist site",
    "description": "The flagship band site: tour dates that split upcoming/past at render time with a computed \"On tour\" / \"Tonight\" badge, a discography with a native waveform player playing bundled original demo loops (paste streaming links and the players swap to the real catalog), click-to-load video, a mailing list, and a full press kit — bios in three lengths, downloadable approved photos and logo marks, stage specs, and contacts. Art-directed in the broadside register: ink-on-paper gig-poster monochrome, big condensed caps, one oxblood accent.",
    "marketingExampleTitle": "Band & musician site",
    "category": "music",
    "homePath": "/",
    "previewPath": "/band",
    "homeViewDir": "web/app/src/View/Band",
    "base": "landing",
    "clientOnly": true,
    "capabilities": ["IOS", "ANDROID"],
    "isDefault": false,
    "forms": {
        "$comment": "Managed-form kinds, formKey -> kind (append-only vocabulary: RSVP | LEAD | MAILING_LIST | PROOFING). Compose stamps these into repobot.deploy.json as formKinds; the dashboard renders declared kinds as typed views and keeps the raw Inbox for undeclared keys.",
        "mailing-list": "MAILING_LIST"
    },
    "theme": {
        "$comment": "The broadside register's overlay: the preset's oxblood ink rides as the project brand so app-side surfaces wear the same two-ink print register as the marketing pages instead of the kernel default blue. Values match the broadside preset's own light/dark accents — the marketing pages resolve brand over preset accent, so keeping them identical re-brands the app without shifting the pages.",
        "brand": {
            "primary": "#a63a2c",
            "primaryDark": "#d05a41"
        }
    },
    "contentContract": {
        "$comment": "The pack's content slots, as data (packs/README.md 'Content contract'): what a composer must bind for a generated variant to present as real. Shows are plain ISO dates — the pages compute the upcoming/past split, the next-show highlight, and the badge at render time. Tracks default to the bundled original demo loops; a track's optional embedUrl swaps its player to a click-to-load streaming embed. Press-kit downloads must point at real files under web/app/public/.",
        "module": "web/app/src/View/Band/content.ts",
        "slots": {
            "band.name": { "kind": "text" },
            "band.tagline": { "kind": "text" },
            "band.location": { "kind": "text" },
            "band.email": { "kind": "text" },
            "home.headline": { "kind": "text" },
            "home.subheadline": { "kind": "text" },
            "home.intro.paragraphs": { "kind": "text[]", "min": 1 },
            "heroImages.marquee": { "kind": "media" },
            "heroImages.portrait": { "kind": "media" },
            "shows": {
                "kind": "collection",
                "min": 4,
                "item": {
                    "date": { "kind": "text" },
                    "city": { "kind": "text" },
                    "venue": { "kind": "text" }
                }
            },
            "records": {
                "kind": "collection",
                "min": 2,
                "item": {
                    "title": { "kind": "text" },
                    "year": { "kind": "number" },
                    "format": { "kind": "text" },
                    "label": { "kind": "text" },
                    "cover": { "kind": "media" },
                    "notes": { "kind": "text" }
                }
            },
            "videos": {
                "kind": "collection",
                "min": 1,
                "item": {
                    "title": { "kind": "text" },
                    "videoUrl": { "kind": "text" },
                    "poster": { "kind": "media" }
                }
            },
            "mailingList.title": { "kind": "text" },
            "mailingList.body": { "kind": "text" },
            "pressKit.bios.short": { "kind": "text" },
            "pressKit.bios.medium": { "kind": "text" },
            "pressKit.bios.long": { "kind": "text[]", "min": 2 },
            "pressKit.photos": {
                "kind": "collection",
                "min": 2,
                "item": {
                    "display": { "kind": "media" },
                    "downloadHref": { "kind": "text" },
                    "credit": { "kind": "text" }
                }
            },
            "pressKit.stage.lineup": { "kind": "text[]", "min": 2 },
            "pressKit.contacts": {
                "kind": "collection",
                "min": 1,
                "item": {
                    "role": { "kind": "text" },
                    "name": { "kind": "text" },
                    "email": { "kind": "text" }
                }
            }
        }
    },
