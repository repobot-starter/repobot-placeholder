# Environment variables for firebase/functions.
# The manifest of record is /env.manifest.json at the repo root; `npm run bootstrap:env`
# generates .env.local from it. This file documents the variables and is the only
# .env.* file that is committed.

# Postgres connection string for this environment's database.
# Local core db: postgres://postgres:postgres@127.0.0.1:5432/postgres
# Local test db: postgres://postgres:postgres@127.0.0.1:5433/postgres
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres

# "local" (emulator-only dev principal tokens) or "builtin" (the kernel's own
# auth service). Deployed boot refuses "local" and crashes with a clear message.
AUTH_MODE=local

# HS256 hex secret for locally issued dev tokens (local/test only).
# Generated per checkout by `npm run bootstrap:env`; never used when deployed.
LOCAL_AUTH_SECRET=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# HS256 hex secret that signs and verifies built-in auth JWTs (dev/prod only).
# Generated per environment by the platform when the AUTH capability is
# declared in repobot.deploy.json; never set this locally.
AUTH_JWT_SECRET=

# Public URL of the auth__request__api function (dev/prod only). Used for
# OAuth callbacks and the magic-link fallback URLs in auth emails.
AUTH_PUBLIC_URL=

# The environment's live site URL (dev/prod only). {{ .SiteURL }} in auth
# emails and the OAuth redirect allowlist; tracks the custom domain.
APP_BASE_URL=

# SMTP account for all outgoing email — auth emails and the mail kernel's
# transactional sends (dev/prod only; injected by the platform). The sender
# vars switch to the owner's verified sender domain when one is active
# (docs/mail.md). Empty host = degraded mode: signups auto-confirm,
# OTP/recovery unavailable, mail-kernel sends log instead of delivering.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_EMAIL=
SMTP_SENDER_NAME=

# Daily cap on outgoing email over the shared SMTP account, per UTC calendar
# day across template + auth mail (dev/prod: staged by the platform). Empty
# or 0 = the kernel default of 200/day; negative = unlimited. Auth emails
# stay deliverable up to 2x the cap (docs/mail.md).
MAIL_DAILY_QUOTA=

# Auth email template overrides (dev/prod only; injected by the platform from
# repobot.emails.json + dashboard overrides) as JSON or base64-encoded JSON.
# Empty = kernel defaults.
AUTH_EMAIL_TEMPLATES=

# Dev-only fixed sign-in code. When set on a dev-posture deploy (or the
# emulator/tests), the email-code verify step also accepts this value for any
# address — sign in test users without email delivery. Leave unset for the
# normal flow; production boot refuses it.
AUTH_DEV_CODE=

# Google OAuth client for the "google" sign-in method (dev/prod only;
# injected from the account's Google Sign-In integration).
GOOGLE_SIGNIN_CLIENT_ID=
GOOGLE_SIGNIN_CLIENT_SECRET=

# Apple Sign-In credentials for the "apple" sign-in method (dev/prod only;
# injected from the account's Apple Sign-In integration). The private key is
# the AuthKey_<keyId>.p8 contents, raw PEM or base64-encoded PEM. The bundle
# id is the native apps' identity-token audience (falls back to the
# Services ID when empty).
APPLE_SIGNIN_SERVICES_ID=
APPLE_SIGNIN_TEAM_ID=
APPLE_SIGNIN_KEY_ID=
APPLE_SIGNIN_PRIVATE_KEY=
APPLE_SIGNIN_BUNDLE_ID=

# "dev" or "prod"; injected by the platform on deploys, empty locally.
# Dev-posture deploys may run simulated payments/AI when no Stripe/OpenAI
# integration is connected yet; prod never may.
DEPLOY_POSTURE=

# "local" (in-app simulated test checkout: emulator, tests, and dev-posture
# deploys without a connected Stripe account) or "stripe".
# Production boot refuses "local" and crashes with a clear message.
PAYMENTS_MODE=local

# Stripe API secret key (dev/prod only). Injected by the platform from the
# account's connected Stripe integration when the PAYMENTS capability is
# declared in repobot.deploy.json; never set this locally.
STRIPE_SECRET_KEY=

# Signing secret ("whsec_...") for the Stripe webhook endpoint
# (payments__request__api POST /webhook). Optional: without it the endpoint
# refuses deliveries; checkout still verifies payment server-side on read.
STRIPE_WEBHOOK_SECRET=

# "local" (simulated assistant: emulator and tests), "openai" (real OpenAI
# models on your own key), or "gateway" (real models through the platform's
# AI gateway — keyless deploys, billed to the account's platform credits).
# Production boot refuses "local" and crashes with a clear message; the
# platform picks "openai" vs "gateway" per deploy.
AI_MODE=local

# OpenAI API secret key (dev/prod only). Injected by the platform when the AI
# capability is declared in repobot.deploy.json. To try the real model in a
# local sandbox, set AI_MODE=openai and paste a key here.
OPENAI_API_KEY=

# Platform AI gateway endpoint + per-environment bearer token (dev/prod
# only). Injected by the platform on keyless AI deploys (AI_MODE=gateway);
# never set these locally.
AI_GATEWAY_URL=
AI_GATEWAY_TOKEN=

# "local" (sandbox: voice turns accept a transcript and skip ElevenLabs),
# "elevenlabs" (real STT/TTS on your own key), or "gateway" (real STT/TTS
# through the platform's AI gateway — keyless deploys, billed to platform
# credits). Production boot refuses "local".
ELEVENLABS_MODE=local

# ElevenLabs API secret key (dev/prod only). Injected by the platform when
# the AI capability is declared. To try real speech in a local sandbox, set
# ELEVENLABS_MODE=elevenlabs and paste a key here.
ELEVENLABS_API_KEY=

# Optional ElevenLabs voice id. Empty uses the kernel default.
ELEVENLABS_VOICE_ID=

# "local" (deterministic simulated QuickBooks sample company — the default
# everywhere) or "intuit" (the real QuickBooks Online API: Intuit OAuth
# connect plus live reads; staged by the platform on deploys).
QUICKBOOKS_MODE=local

# Intuit app OAuth client credentials (dev/prod only). Injected by the
# platform from the account's connected Intuit integration alongside
# QUICKBOOKS_MODE=intuit; never set these locally.
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=

# "sandbox" or "production": which Intuit environment the app's keys belong
# to; picks the QuickBooks Online API host. Ignored in local mode.
QUICKBOOKS_ENVIRONMENT=production

# "local" (renders PDFs with the machine's own Chromium; emulator/tests only)
# or "platform" (the platform-hosted render service).
# Deployed boot refuses "local" and crashes with a clear message.
DOCUMENTS_MODE=local

# Base URL of the platform's document render service (dev/prod only).
# Injected by the platform when the DOCUMENTS capability is declared in
# repobot.deploy.json; never set this locally.
DOCUMENTS_RENDER_URL=

# Bearer token for the document render service, scoped to this deploy
# (dev/prod only; minted by the platform). Never set this locally.
DOCUMENTS_TOKEN=

# Optional path to a Chromium/Chrome executable for local PDF rendering.
# Well-known install locations are probed when unset.
DOCUMENTS_CHROMIUM_PATH=

# "local" (file bytes on disk under STORAGE_LOCAL_DIR, served by the storage
# function: emulator, tests, and dev-posture deploys without provisioned
# storage) or "gcs" (a provisioned Cloud Storage bucket via V4 signed URLs).
# Production boot refuses "local" and crashes with a clear message.
STORAGE_MODE=local

# Name of the provisioned Cloud Storage bucket (dev/prod only). Injected by
# the platform when the STORAGE capability is declared in repobot.deploy.json;
# never set this locally.
STORAGE_BUCKET=

# Object key prefix inside STORAGE_BUCKET (dev/prod only; injected by the
# platform so environments sharing a bucket never collide). Empty = root.
STORAGE_PREFIX=

# Optional override for the local-mode storage data directory.
# Defaults to .devdata/storage at the repo root.
STORAGE_LOCAL_DIR=

# "local" (an in-process 60s ticker runs due jobs: emulator, tests, and
# dev-posture deploys without a provisioned scheduler) or "scheduler" (the
# platform's Cloud Scheduler POSTs /tick on jobs__request__api).
# Production boot refuses "local" and crashes with a clear message.
JOBS_MODE=local

# Bearer token guarding POST /tick (dev/prod only). Minted per environment
# by the platform when the JOBS capability is declared in
# repobot.deploy.json; never set this locally.
JOBS_TOKEN=

# "local" (no real delivery: the emulator/tests record pushes with the
# in-memory fake, and a deploy in this mode treats push as not configured) or
# "live" (Web Push over the platform-minted VAPID keypair). Unconfigured
# sends degrade to a log line — never a boot failure.
PUSH_MODE=local

# VAPID keypair for Web Push (dev/prod: minted per project by the platform's
# PUSH_CREDENTIALS step). Empty = the WEB channel is not configured. Optional
# locally: paste a pair from `npx web-push generate-vapid-keys` here (and the
# public key into web/app's VITE_VAPID_PUBLIC_KEY) to exercise the browser
# subscribe flow end-to-end against the emulator's fake transport.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
